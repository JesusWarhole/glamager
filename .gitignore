# Ποτέ στο git — service account credential (πλήρης πρόσβαση στο Firebase project)
firebase-key.json

# Firebase CLI local cache/state — δεν χρειάζεται στο repo
.firebase/

# Cloud Functions local env (PUSH_TRIGGER_TOKEN κ.ά.) — φορτώνεται αυτόματα από
# firebase-functions v2 σε deploy/emulator, ποτέ στο git
functions/.env

# Λοιπά τυπικά
.DS_Store
*.log
node_modules/

# Ποτέ ολόκληρα zip backups/exports του project στο repo (μπορεί να περιέχουν credentials)
*.zip
